{
    "adobe-acrobat-hooman": 
    {
        "cli": "MorpheApp/morphe-cli",
        "patches": [
            {   
                "patchname": "hooman",
                "patchsrc": "arandomhooman/hoomans-morphe-patches",
                "source": "github"
            }
        ],
        "pkgname": "com.adobe.reader",
        "apksrc": "apkmirror",
        "apktype": "bundle",
        "archs": ["universal"],
        "version_cmd": "_fs_get https://www.apkmirror.com/apk/adobe/adobe-acrobat/feed/ && version=$(curl -s https://www.apkmirror.com/apk/adobe/adobe-acrobat/feed/ -H \"Cookie: $FS_COOKIES\" -H \"User-Agent: $user_agent\" | tail -n +4 | sed -e 's/^[ \t]*//' | sed -e 's/<title>//' -e 's/<\\/title>//' -e 's/<description>/  /' -e 's/<\\/description>//' | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+' | sort | tail -n 1)" 
    },
