    "youtube-morphe": 
    {
        "cli": "MorpheApp/morphe-cli",
        "patches": [
            {
                "patchname": "morphe",
                "patchsrc": "MorpheApp/morphe-patches",
                "source": "github",
                "clioptions": "-e 'Custom branding' -OcustomName='YouTube Morphe' -e Theme -OdarkThemeBackgroundColor=#000000 -d 'Custom Header'",
                "rootclioptions": "-d 'GmsCore Support'"
            }
        ],
        "module": "true",
        "pkgname": "com.google.android.youtube",
        "apksrc": "apkmirror",
        "apktype": "apk",
        "archs": ["universal"],
        "version_cmd": "get_experimental_version com.google.android.youtube"
    },
